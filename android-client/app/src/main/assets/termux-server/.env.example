# Qwenton Apex Termux Server Configuration
HOST=127.0.0.1
PORT=8765
DEBUG=false

# Allowed working directories for safe file access (comma separated)
ALLOWED_DIRECTORIES=/data/data/com.termux/files/home

# Optional remote AI provider credentials (kept strictly in Termux server)
# PROVIDER options: mock | gemini | openai | anthropic | local | custom
AI_PROVIDER=mock
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Local LLM endpoint (e.g. llama.cpp or Ollama running locally in Termux)
LOCAL_LLM_URL=http://127.0.0.1:8080/v1

# Custom online provider (OpenRouter, Groq, DeepSeek, Together, vLLM, etc.)
CUSTOM_BASE_URL=https://openrouter.ai/api/v1
CUSTOM_API_KEY=
AI_MODEL=gemini-1.5-pro
